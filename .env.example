# WIP application environment template. Copy to /home/WIP/.env and fill values.
# .env is gitignored — never commit real secrets.

# WIP's own database (separate database, same MariaDB instance as ERic)
NIF_WIP_DB_HOST=localhost
NIF_WIP_DB_PORT=3336
NIF_WIP_DB_NAME=nif_wip
NIF_WIP_DB_USER=wip_app
NIF_WIP_DB_PASS=

# Excel mastercopy import path (transitional)
NIF_WIP_CSV_PATH=/home/ELT/data/MASTERCOPY-V2.xlsx

# Read-only access to ERic canonical resolution tables in nif_elt
# (for resolving firm identity at WIP import time)
NIF_DB_HOST=localhost
NIF_DB_PORT=3336
NIF_DB_NAME=nif_elt
NIF_DB_USER=
NIF_DB_PASS=
