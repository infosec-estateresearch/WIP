[Unit]
Description=WIP Mastercopy -> WIP SQL import (WO-22)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/WIP
ExecStart=/usr/bin/python3 -m scripts.import_mastercopy_wip --source /home/ELT/data/MASTERCOPY-V2.xlsx --apply
Environment=PYTHONPATH=/home/WIP
Environment=NIF_WIP_ENV_PATH=/home/WIP/.env
TimeoutStartSec=900
SuccessExitStatus=0
StandardOutput=journal
StandardError=journal
